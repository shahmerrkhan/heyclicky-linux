# --- Vision mode (Gemini) -----------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey
# Clicky still starts without it (Code mode keeps working), but vision
# requests will show a "key missing" message in the bubble.
GEMINI_API_KEY=

# Fast model: answers every question first. Thinking level: low, medium or high.
# "minimal" isn't allowed (the fast model tends to drop the pointing tag
# without thinking).
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_THINKING_LEVEL=medium

# Strong model: takes over when the fast one fails, or goes first when you
# start a question with /p.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# Seconds each try gets to produce its first word (covers one busy retry too).
# Once an answer starts it is never cut off.
FAST_FIRST_WORD_TIMEOUT_S=10
# Strong model taking over from a failed fast model.
STRONG_TAKEOVER_TIMEOUT_S=20
# Strong model asked for with /p.
STRONG_REQUEST_TIMEOUT_S=90
# Without /p: rounds of fast-then-strong tries before giving up, and the pause
# between rounds.
FALLBACK_ROUNDS=3
ROUND_PAUSE_S=3
# Wait before retrying a busy model.
RETRY_WAIT_S=2

# --- Web search (Tavily) ------------------------------------------------------
# Start a question with "/s " to search the web first. Free plan: 1,000
# credits/month; each search costs 2 (advanced depth). Without a key, /s
# questions are answered without search and the bubble says so.
TAVILY_API_KEY=

# Browser that opens links clicked in the bubble (search sources).
# The URL is appended as the last argument. Leave empty for the system default.
LINK_BROWSER_COMMAND=opera-gx

# Output token cap per answer. Gemini's thinking tokens count toward this,
# so keep it high enough that the [POINT] tag at the end never gets cut off.
MAX_TOKENS=8192

# Push-to-text hotkey, pynput notation.
# Default: ctrl + alt + space. Modifier-only combos (just ctrl+alt) are not reliable.
# Examples: "<ctrl>+<alt>+<space>", "<ctrl>+<shift>+c", "<f12>"
HOTKEY=<ctrl>+<alt>+<space>

# --- Code mode (Claude Code subprocess) ---------------------------------------
# Code mode swaps the Gemini vision pipeline for the `claude` CLI running as a
# subprocess in the workspace below. Toggle vision/code at runtime from the
# input bar.

# Path to the `claude` binary. Leave as "claude" if it's on PATH.
CLAUDE_CODE_PATH=claude

# Default working directory for Code mode. You can override per-prompt by
# prefixing with @/path (e.g. `@~/dev/foo fix the lint errors`).
# Defaults to the Clicky repo so you can have Clicky hack on itself.
# CLAUDE_CODE_WORKSPACE=/home/you/dev/myproject

# Optional model alias for Code mode. Leave blank to use Claude Code's default.
# Examples: sonnet, opus, claude-sonnet-4-6
CLAUDE_CODE_MODEL=

# Hard cap on agent turns per prompt. 0 = no cap.
CLAUDE_CODE_MAX_TURNS=0
